# ========================================================
# Paddle Merchant of Record Configuration
# ========================================================

# Environment toggle: 'sandbox' during testing, 'production' for live payments
NEXT_PUBLIC_PADDLE_ENV=production

# Client-side Token:
# - Sandbox: starts with "test_" (Paddle Sandbox > Developer tools > Authentication)
# - Live:    starts with "live_" (Paddle Live    > Developer tools > Authentication)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Catalog Identifiers:
# - Product ID: pro_...
# - Price ID: pri_... ($9.00 USD)
NEXT_PUBLIC_PADDLE_PRODUCT_ID=pro_xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-Side API Key:
# - Paddle Dashboard > Developer Tools > Authentication > New API Key
PADDLE_API_KEY=pdl_live_apikey_xxxxxxxxxxxxxxxxxxxx

# Webhook Notification Secret:
# - Secret key starting with "pdl_ntfset_..." obtained when creating a Destination
# - Paddle Dashboard > Developer Tools > Notifications > New destination
# - Destination URL: https://www.raisedgardenbedslayout.com/api/webhooks/paddle
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxx

# ========================================================
# Resend Transactional Email Delivery Configuration
# ========================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Raised Garden Beds <orders@raisedgardenbedslayout.com>
NEXT_PUBLIC_SITE_URL=https://www.raisedgardenbedslayout.com
